{
  "name": "tmux-remote-control",
  "version": "0.1.0",
  "description": "Compose input locally and send it to the focused pane of a remote tmux session",
  "license": "MIT",
  "files": [
    "bin/",
    "lib/",
    "pi-extension.ts",
    "install-pi-extension.sh",
    "test/"
  ],
  "bin": {
    "tmux-remote-control": "./bin/tmux-remote-control"
  },
  "pi": {
    "extensions": [
      "./pi-extension.ts"
    ]
  },
  "keywords": [
    "tmux",
    "ssh",
    "remote-control",
    "pi-package"
  ],
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "check": "bash -n bin/tmux-remote-control install-pi-extension.sh && node --check bin/tmux-remote-control-prompt.mjs && node --check bin/tmux-remote-control-pi.cjs && node --check lib/pi-remote.cjs",
    "install:pi": "./install-pi-extension.sh",
    "test": "node --test test/*.test.cjs && bash test/tmux-remote-control.test.sh",
    "test:pi": "PI_TUI_TEST=1 node --test test/pi-tui.test.cjs",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "jiti": "^2.7.0"
  }
}
